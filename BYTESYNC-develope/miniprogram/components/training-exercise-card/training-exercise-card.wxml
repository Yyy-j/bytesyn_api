<!-- components/training-exercise-card/training-exercise-card.wxml — 训练打卡组件 -->
<view class="exercise-card card">
  <!-- 动作信息 -->
  <view class="exercise-header" bind:tap="toggleInput">
    <view class="exercise-info">
      <text class="exercise-name">{{exercise.exerciseName}}</text>
      <text class="exercise-category">{{exercise.category || '其他'}}</text>
    </view>
    <view class="exercise-progress">
      <text class="progress-text {{exercise.completedSets >= exercise.targetSets ? 'completed' : ''}}">
        {{exercise.completedSets || 0}} / {{exercise.targetSets || 0}}
      </text>
    </view>
  </view>

  <!-- 目标信息 -->
  <view class="exercise-target">
    <block wx:if="{{exercise.itemType !== 'cardio'}}">
      <text class="target-item">{{exercise.targetWeight || 0}}kg × {{exercise.targetReps || 12}}次</text>
    </block>
    <block wx:else>
      <text class="target-item">{{exercise.targetDuration || 0}}秒</text>
    </block>
  </view>

  <!-- 打卡按钮（非只读模式） -->
  <view wx:if="{{!readonly}}" class="checkin-section">
    <button
      class="checkin-btn {{exercise.completedSets >= exercise.targetSets ? 'disabled' : ''}}"
      disabled="{{exercise.completedSets >= exercise.targetSets || isSubmitting}}"
      loading="{{isSubmitting}}"
      bind:tap="onCheckin"
    >
      <text wx:if="{{exercise.completedSets >= exercise.targetSets}}">已完成</text>
      <text wx:else>+1 组</text>
    </button>
  </view>

  <!-- 输入区域（可展开，非只读模式） -->
  <view wx:if="{{showInput && !readonly}}" class="input-section">
    <view class="input-row" wx:if="{{exercise.itemType !== 'cardio'}}">
      <view class="input-group">
        <text class="input-label">重量</text>
        <input
          class="input-field"
          type="digit"
          placeholder="kg"
          value="{{inputWeight}}"
          bindinput="onWeightInput"
        />
      </view>
      <view class="input-group">
        <text class="input-label">次数</text>
        <input
          class="input-field"
          type="number"
          placeholder="次"
          value="{{inputReps}}"
          bindinput="onRepsInput"
        />
      </view>
    </view>
    <view class="input-row">
      <view class="input-group">
        <text class="input-label">RPE</text>
        <input
          class="input-field"
          type="number"
          placeholder="1-10"
          value="{{inputRpe}}"
          bindinput="onRpeInput"
        />
      </view>
      <view class="input-group flex-1">
        <text class="input-label">备注</text>
        <input
          class="input-field"
          type="text"
          placeholder="可选"
          value="{{inputRemark}}"
          bindinput="onRemarkInput"
        />
      </view>
    </view>
  </view>

  <!-- 已完成组详情 -->
  <view wx:if="{{exercise.setDetails && exercise.setDetails.length > 0}}" class="set-details">
    <view class="set-detail-item" wx:for="{{exercise.setDetails}}" wx:key="requestId">
      <!-- 编辑模式 -->
      <block wx:if="{{editingSetIndex === index && !readonly}}">
        <view class="edit-form">
          <text class="set-number">第{{index + 1}}组</text>
          <view class="edit-row" wx:if="{{exercise.itemType !== 'cardio'}}">
            <input class="edit-field" type="digit" placeholder="重量" value="{{editWeight}}" bindinput="onEditWeightInput" />
            <input class="edit-field" type="number" placeholder="次数" value="{{editReps}}" bindinput="onEditRepsInput" />
            <input class="edit-field" type="number" placeholder="RPE" value="{{editRpe}}" bindinput="onEditRpeInput" />
          </view>
          <view class="edit-row" wx:else>
            <input class="edit-field" type="number" placeholder="RPE" value="{{editRpe}}" bindinput="onEditRpeInput" />
          </view>
          <view class="edit-row">
            <input class="edit-field flex-1" type="text" placeholder="备注" value="{{editRemark}}" bindinput="onEditRemarkInput" maxlength="200" />
          </view>
          <view class="edit-actions">
            <text class="edit-cancel" bind:tap="onCancelEdit">取消</text>
            <text class="edit-save" bind:tap="onSaveEdit">{{isEditing ? '保存中...' : '保存'}}</text>
          </view>
        </view>
      </block>
      <!-- 显示模式 -->
      <block wx:else>
        <text class="set-number">第{{index + 1}}组</text>
        <text class="set-info">
          <text wx:if="{{item.weight !== undefined && item.weight !== null}}">{{item.weight}}kg</text>
          <text wx:if="{{item.reps !== undefined && item.reps !== null}}"> × {{item.reps}}</text>
          <text wx:if="{{item.rpe !== undefined && item.rpe !== null && item.rpe !== ''}}"> ｜ RPE {{item.rpe}}</text>
        </text>
        <text wx:if="{{item.remark}}" class="set-remark">{{item.remark}}</text>
        <text wx:if="{{!readonly}}" class="edit-btn" data-index="{{index}}" bind:tap="onStartEdit">编辑</text>
      </block>
    </view>
  </view>

  <!-- 教学视频链接 -->
  <view wx:if="{{exercise.videoLinks && exercise.videoLinks.length > 0}}" class="video-links">
    <view class="video-links-header">
      <text class="video-links-title">🎬 教学视频</text>
    </view>
    <view class="video-link-list">
      <view wx:for="{{exercise.videoLinks}}" wx:key="videoId" class="video-link-item" data-video="{{item}}" bind:tap="onVideoAction">
        <text class="video-link-name">{{item.title}}</text>
        <text class="video-link-arrow">›</text>
      </view>
    </view>
  </view>
</view>
