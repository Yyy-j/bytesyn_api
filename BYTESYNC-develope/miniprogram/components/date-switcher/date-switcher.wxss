/* components/date-switcher/date-switcher.wxss */

.date-switcher {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--color-text-tertiary);
  line-height: 1;
  user-select: none;
}

.date-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  font-weight: 500;
}
