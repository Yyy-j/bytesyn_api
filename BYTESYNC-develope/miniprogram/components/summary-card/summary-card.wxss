/* components/summary-card/summary-card.wxss */

.summary-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
  animation: card-enter 0.4s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes card-enter {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ── 顶部：用户名 + 完成度（弱化） ── */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--spacing-sm);
}

.user-name {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text-secondary);
}

.pct-label {
  font-size: var(--font-size-xs);
  font-weight: 500;
  color: var(--color-text-tertiary);
}

/* ── 热量主数字 ── */
.cal-block {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.cal-current {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1;
}

.cal-unit {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  font-weight: 400;
}

.cal-goal {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-md);
}

/* ── 分割线 ── */
.card-divider {
  height: 1rpx;
  background: var(--color-border);
  margin-bottom: var(--spacing-md);
}

/* ── 我（蓝色） ── */
.summary-card.me .cal-current { color: var(--color-me); }
.summary-card.me .pct-label   { color: var(--color-me); }

/* ── Ta（黄色） ── */
.summary-card.ta .cal-current { color: var(--color-carbs); }
.summary-card.ta .pct-label   { color: var(--color-carbs); }

/* ── 超标警告 ── */
.summary-card.over .cal-current { color: var(--color-warning); }
.summary-card.over .pct-label   { color: var(--color-warning); }
