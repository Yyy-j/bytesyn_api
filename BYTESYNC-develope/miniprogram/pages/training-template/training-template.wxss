/* pages/training-template/training-template.wxss — 模板编辑页样式 */
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ── 状态容器 ── */
.state-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
  gap: var(--spacing-md);
  margin: var(--page-padding);
}

.error-icon {
  font-size: 80rpx;
}

.error-msg {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
}

.retry-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: none;
  border-radius: var(--radius-full);
}

/* ── 内容区 ── */
.content {
  padding-bottom: 180rpx;
}

/* ── 星期切换 ── */
.day-tabs {
  display: flex;
  background: var(--color-bg-card);
  padding: var(--spacing-sm) var(--spacing-md);
  white-space: nowrap;
  border-bottom: 1rpx solid var(--color-border);
}

.day-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  margin-right: var(--spacing-sm);
  border-radius: var(--radius-md);
  background: var(--color-bg);
  min-width: 80rpx;
}

.day-tab.active {
  background: var(--color-primary);
}

.day-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
}

.day-tab.active .day-name {
  color: #fff;
}

.day-count {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

.day-tab.active .day-count {
  color: rgba(255, 255, 255, 0.8);
}

/* ── 动作区域 ── */
.exercise-section {
  padding: var(--page-padding);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.add-btn {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-primary-light);
  border-radius: var(--radius-full);
}

.add-icon {
  font-size: var(--font-size-lg);
  color: var(--color-primary);
  font-weight: bold;
}

.add-text {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
}

/* ── 空状态 ── */
.empty-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xxl) var(--spacing-xl);
  gap: var(--spacing-sm);
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

/* ── 动作列表 ── */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.exercise-card {
  padding: var(--spacing-md);
}

/* ── 动作内容 ── */
.exercise-content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.exercise-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.exercise-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.exercise-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.exercise-category {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.exercise-stats {
  display: flex;
  gap: var(--spacing-sm);
}

.stat {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
}

/* ── 操作按钮 ── */
.exercise-actions {
  display: flex;
  gap: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.action-btn {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
}

.action-btn.edit {
  color: var(--color-primary);
}

.action-btn.delete {
  color: var(--color-warning);
}

/* ── 编辑模式 ── */
.exercise-edit {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.edit-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.edit-type {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  background: var(--color-bg);
  padding: 4rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
}

.edit-form {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.edit-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.edit-label {
  width: 140rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.edit-input {
  flex: 1;
  height: 72rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

/* ── 视频链接行 ── */
.video-link-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-top: 1rpx solid var(--color-border);
  margin-top: var(--spacing-sm);
}

.video-link-label {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.video-link-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-right: var(--spacing-sm);
}

.video-link-arrow {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
}

.edit-actions {
  display: flex;
  gap: var(--spacing-md);
  padding-top: var(--spacing-sm);
}

.edit-cancel,
.edit-save {
  flex: 1;
  height: 72rpx;
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
  border: none;
}

.edit-cancel {
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.edit-save {
  background: var(--color-primary);
  color: #fff;
}

/* ── 底部保存栏 ── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-md) var(--page-padding);
  background: var(--color-bg-card);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
}

.save-btn.disabled {
  opacity: 0.6;
}
