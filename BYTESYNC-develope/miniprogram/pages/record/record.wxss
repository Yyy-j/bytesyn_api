/* pages/record/record.wxss */

.page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* ══════════════════════════════════════
   IDLE 状态
══════════════════════════════════════ */

.idle-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-xl) var(--page-padding) 0;
  padding-bottom: calc(var(--spacing-xxl) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-xxl) + env(safe-area-inset-bottom));
}

.idle-header {
  padding-top: var(--spacing-xl);
}

.page-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
}

.idle-camera {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xl);
  padding: var(--spacing-xl) 0;
  min-height: 70vh;
}

/* ── 辅助提示输入框行 ── */
.hint-row {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  align-items: flex-end;
  gap: var(--spacing-sm);
}

.hint-input {
  flex: 1;
  min-width: 0;
  min-height: 96rpx;      /* 至少两行 */
  background: rgba(111, 207, 151, 0.08);
  border: 1.5rpx solid rgba(111, 207, 151, 0.3);
  border-radius: 24rpx;
  padding: 22rpx 32rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

/* ── 文字发送按钮 ── */
.hint-send-btn {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  background: var(--color-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.hint-send-btn.hint-send-disabled {
  opacity: 0.35;
}

.hint-send-icon {
  width: 32rpx;
  height: 32rpx;
}

.hint-placeholder {
  color: var(--color-text-tertiary);
  font-size: var(--font-size-sm);
}

.footer-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  letter-spacing: 1rpx;
}

/* ══════════════════════════════════════
   LOADING 状态
══════════════════════════════════════ */

.loading-page {
  width: 100%;
  height: 100vh;
  background: #F8FCF9;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow: hidden;
}

/* ── 扫描框气泡（轻量装饰）── */
.lp-scan {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
  margin-bottom: 4rpx;
}

.lp-scan-frame {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  background: rgba(111, 207, 151, 0.08);
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lp-scan-corner {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-style: solid;
  border-color: var(--color-primary);
}

.lp-scan-tl { top: 4rpx; left: 4rpx; border-width: 2rpx 0 0 2rpx; border-top-left-radius: 3rpx; }
.lp-scan-tr { top: 4rpx; right: 4rpx; border-width: 2rpx 2rpx 0 0; border-top-right-radius: 3rpx; }
.lp-scan-bl { bottom: 4rpx; left: 4rpx; border-width: 0 0 2rpx 2rpx; border-bottom-left-radius: 3rpx; }
.lp-scan-br { bottom: 4rpx; right: 4rpx; border-width: 0 2rpx 2rpx 0; border-bottom-right-radius: 3rpx; }

.lp-scan-heart {
  font-size: 22rpx;
  animation: lp-pulse 1.6s ease-in-out infinite;
}

@keyframes lp-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%       { transform: scale(0.82); opacity: 0.65; }
}

.lp-scan-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
  letter-spacing: 1rpx;
}

/* ── 主插画区（核心视觉）── */
.lp-hero-wrap {
  width: 100%;
  max-width: 680rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -4rpx 0 0;
  flex-shrink: 0;
}

.lp-hero {
  width: 620rpx;
  max-width: 100%;
}

/* ── 文案组 ── */
.lp-text-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lp-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  text-align: center;
  letter-spacing: 1rpx;
}

.lp-subtitle {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.4;
}

/* ── 进度条卡片 ── */
.lp-progress-card {
  width: 100%;
  background: #fff;
  flex-shrink: 0;
  border-radius: var(--radius-lg);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 12rpx var(--spacing-lg);
  box-sizing: border-box;
  margin-top: 20rpx;
}

.lp-progress-track {
  width: 100%;
  height: 8rpx;
  background: rgba(111, 207, 151, 0.2);
  border-radius: var(--radius-full);
  overflow: hidden;
}

.lp-progress-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-full);
  transition: width 0.6s ease;
}

/* ── 底部提示胶囊 ── */
.lp-tip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid rgba(111, 207, 151, 0.4);
  border-radius: var(--radius-full);
  padding: 8rpx 22rpx;
  background: rgba(111, 207, 151, 0.04);
  flex-shrink: 0;
  margin-top: 20rpx;
}

.lp-tip-leaf {
  font-size: 18rpx;
  line-height: 1;
}

.lp-tip-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 0.5rpx;
}

/* ══════════════════════════════════════
   RESULT 状态
══════════════════════════════════════ */

.result-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--spacing-xl) var(--page-padding) 0;
  padding-bottom: calc(320rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.result-header {
  padding-top: var(--spacing-xl);
  margin-bottom: var(--spacing-lg);
}

.result-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.result-card-wrap {
  margin-bottom: var(--spacing-lg);
}

/* ── 份量快捷调整 ── */
.ratio-section {
  margin-bottom: var(--spacing-lg);
}

.ratio-title {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.ratio-buttons {
  display: flex;
  gap: var(--spacing-sm);
}

.ratio-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
  text-align: center;
}

.ratio-btn::after {
  border: none;
}

.ratio-btn.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* 底部操作区（固定 + 安全区） */
/* ── 共享这一餐 ── */
.share-section {
  margin-bottom: var(--spacing-lg);
}

.share-title {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.share-mode-row {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}

.share-chip {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.share-chip.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

.split-section {
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.split-title {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-bottom: var(--spacing-sm);
}

.split-row {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.split-chip {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.split-chip.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

.share-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.share-preview-me {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-me);
}

.share-preview-sep {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.share-preview-ta {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-carbs);
}

/* ── 底部操作区（固定 + 安全区） */
.result-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-md) var(--page-padding);
  padding-bottom: calc(var(--spacing-md) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-md) + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* 继承全局 .primary-btn，补充 button 元素所需的宽度与边框重置 */
.result-save-btn {
  width: 100%;
}

.result-save-btn::after {
  border: none;
}

.btn-ghost {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
  border: none;
  border-radius: var(--radius-full);
}

.btn-ghost::after {
  border: none;
}

/* ══════════════════════════════════════
   手动记录区域
══════════════════════════════════════ */

.manual-section {
  width: 100%;
  max-width: 560rpx;
}

.manual-toggle {
  display: block;
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  padding: var(--spacing-xs) 0;
}

.manual-form {
  margin-top: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.manual-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.manual-row:last-of-type {
  border-bottom: none;
}

.manual-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  width: 160rpx;
  flex-shrink: 0;
}

.manual-required {
  color: var(--color-warning, #EB5757);
}

.manual-input {
  flex: 1;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  text-align: right;
}

.manual-save-btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: var(--spacing-lg);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: 600;
  border-radius: var(--radius-full);
  border: none;
  line-height: normal;
}

.manual-save-btn::after {
  border: none;
}

/* ══════════════════════════════════════
   昨天也吃了？（快捷复用模块）
══════════════════════════════════════ */

.yesterday-section {
  width: 100%;
  max-width: 560rpx;
}

.section-label {
  display: block;
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-sm);
}

.yesterday-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.yesterday-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.yesterday-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}

.yesterday-name {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yesterday-cal {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.yesterday-add-btn {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: 500;
  border-radius: var(--radius-sm);
}

/* ══════════════════════════════════════
   识别后修改区域（result 状态）
══════════════════════════════════════ */

.modify-section {
  margin-bottom: var(--spacing-lg);
}

.modify-chips {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.modify-chip {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-surface);
  border: 1.5rpx solid var(--color-border);
  border-radius: var(--radius-full);
}

.modify-chip.active {
  color: var(--color-primary);
  background: rgba(111, 207, 151, 0.12);
  border-color: var(--color-primary);
  font-weight: 600;
}

.modify-panel {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-card);
}

.modify-textarea {
  width: 100%;
  min-height: 120rpx;
  background: rgba(111, 207, 151, 0.08);
  border: 1.5rpx solid rgba(111, 207, 151, 0.3);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-primary);
  line-height: 1.6;
  box-sizing: border-box;
}

.modify-tip {
  display: block;
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: var(--spacing-sm);
}

.modify-save-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin-top: var(--spacing-md);
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-sm);
  font-weight: 600;
  border-radius: var(--radius-full);
  border: none;
  line-height: normal;
}

.modify-save-btn::after {
  border: none;
}
