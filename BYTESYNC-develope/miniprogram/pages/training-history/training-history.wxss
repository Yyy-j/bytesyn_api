/* pages/training-history/training-history.wxss — 训练历史页面样式 */
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: 100rpx;
}

/* ── 状态容器 ── */
.state-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

/* ── Loading ── */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ── 错误状态 ── */
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
  gap: var(--spacing-md);
}

.error-icon {
  font-size: 80rpx;
}

.error-msg {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  text-align: center;
}

.retry-btn {
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: none;
  border-radius: var(--radius-full);
}

/* ── 空状态 ── */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xxl) var(--spacing-xl);
  gap: var(--spacing-sm);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
}

.empty-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  text-align: center;
}

/* ── 历史列表 ── */
.history-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* ── 周卡片 ── */
.week-item {
  overflow: hidden;
}

.week-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md);
}

.week-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.week-id {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.week-range {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.week-summary {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.week-progress {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.expand-icon {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

/* ── 周详情 ── */
.week-detail {
  padding: 0 var(--spacing-md) var(--spacing-md);
  border-top: 1rpx solid var(--color-border);
}

.day-section {
  padding: var(--spacing-md) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.day-section:last-child {
  border-bottom: none;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.day-name {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}

.day-date {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
}

.rest-day {
  padding: var(--spacing-md);
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ── 加载更多 ── */
.load-more, .no-more {
  text-align: center;
  padding: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.load-more text {
  color: var(--color-primary);
}
