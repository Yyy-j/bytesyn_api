/* pages/training-video/training-video.wxss — 教学视频管理页样式 */

.video-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 视频列表 */
.video-list {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.empty-tip {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.video-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.video-item:last-child {
  border-bottom: none;
}

.video-info {
  flex: 1;
  overflow: hidden;
}

.video-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-url {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.video-actions {
  display: flex;
  gap: 20rpx;
  margin-left: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.action-btn.edit {
  color: #4A90E2;
}

.action-btn.delete {
  color: #E74C3C;
}

/* 添加按钮 */
.add-section {
  margin-top: 32rpx;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #6FCF97;
  color: #fff;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: none;
}

.add-btn.disabled {
  background-color: #ccc;
}

/* 表单弹窗 */
.form-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.form-popup {
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}

.form-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.form-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.form-body {
  flex: 1;
  min-height: 0;
  max-height: 50vh;
  padding: 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.form-footer {
  flex-shrink: 0;
  display: flex;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  border-top: 1rpx solid #eee;
  background-color: #fff;
}

.form-cancel-btn,
.form-save-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 8rpx;
  border: none;
}

.form-cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.form-save-btn {
  background-color: #6FCF97;
  color: #fff;
}

.form-save-btn[disabled] {
  background-color: #ccc;
}
