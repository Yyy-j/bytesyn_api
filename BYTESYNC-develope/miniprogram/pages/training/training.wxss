/* pages/training/training.wxss — 训练首页样式 */
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  padding: var(--page-padding);
  padding-bottom: 200rpx;
}

/* ── 页面标题 ── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) 0;
}

.page-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.header-link {
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  padding: var(--spacing-xs) var(--spacing-sm);
}

/* ── 状态容器 ── */
.state-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

/* ── Loading 状态 ── */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ── 错误状态 ── */
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
  gap: var(--spacing-md);
}

.error-icon {
  font-size: 80rpx;
}

.error-msg {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
  text-align: center;
}

.retry-btn {
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: none;
  border-radius: var(--radius-full);
}

/* ── 空状态 ── */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xxl) var(--spacing-xl);
  gap: var(--spacing-sm);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: var(--spacing-md);
}

.empty-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.5;
}

.create-btn {
  margin-top: var(--spacing-lg);
  width: 100%;
}

/* ── 内容区域 ── */
.content {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* ── 日期切换 ── */
.day-tabs {
  display: flex;
  white-space: nowrap;
  margin: 0 calc(-1 * var(--page-padding));
  padding: 0 var(--page-padding);
}

.day-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  margin-right: var(--spacing-xs);
  border-radius: var(--radius-md);
  background: var(--color-bg-card);
  min-width: 80rpx;
}

.day-tab.active {
  background: var(--color-primary);
}

.day-tab.active .day-name {
  color: #fff;
}

.day-name {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.today-dot {
  font-size: 32rpx;
  color: var(--color-primary);
  line-height: 1;
  margin-top: -4rpx;
}

.day-tab.active .today-dot {
  color: #fff;
}

/* ── 训练列表 ── */
.exercise-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

/* ── 休息日 ── */
.rest-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
  gap: var(--spacing-sm);
}

.rest-icon {
  font-size: 80rpx;
}

.rest-text {
  font-size: var(--font-size-lg);
  color: var(--color-text-secondary);
}
