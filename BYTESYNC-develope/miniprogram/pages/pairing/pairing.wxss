/* pages/pairing/pairing.wxss */
@import "../../styles/variables.wxss";
@import "../../styles/common.wxss";

/* ── 页面容器 ───────────────────────────────────────── */
.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  padding: var(--spacing-xl) var(--page-padding);
  box-sizing: border-box;
}

/* ── 全局加载 ────────────────────────────────────────── */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
}
.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ── 场景公共布局 ─────────────────────────────────────── */
.scene {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-lg);
}

/* ── Hero 区 ─────────────────────────────────────────── */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
}
.app-name {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 4rpx;
}
.tagline {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}
.scene-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}
.scene-sub {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  text-align: center;
}

/* ── 按钮组 ──────────────────────────────────────────── */
.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

/* 复用 common.wxss .primary-btn 基础，再覆盖宽度 */
.btn {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-md);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.btn::after { border: none; }

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  box-shadow: var(--shadow-btn);
}
.btn-primary[disabled] {
  opacity: 0.55;
}

.btn-ghost {
  background: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

/* ── 邀请码卡片 ──────────────────────────────────────── */
.code-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl) 64rpx;
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}
.invite-code {
  font-size: var(--font-size-num);
  font-weight: 700;
  color: var(--color-primary);
  letter-spacing: 16rpx;
}

.hint {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
  padding: 0 var(--spacing-md);
}

/* ── 输入框 ──────────────────────────────────────────── */
.code-input {
  width: 100%;
  height: 96rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-lg);
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
  text-align: center;
  letter-spacing: 8rpx;
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
}

.back-link {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  padding: var(--spacing-sm) var(--spacing-md);
}
