/* pages/training-exercise/training-exercise.wxss — 动作选择页样式 */
@import '/styles/common.wxss';

.page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ── 状态容器 ── */
.state-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80vh;
}

.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-md);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl);
  gap: var(--spacing-md);
  margin: var(--page-padding);
}

.error-icon {
  font-size: 80rpx;
}

.error-msg {
  font-size: var(--font-size-sm);
  color: var(--color-warning);
}

.retry-btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: none;
  border-radius: var(--radius-full);
}

/* ── 内容区 ── */
.content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* ── 搜索栏 ── */
.search-bar {
  padding: var(--spacing-md) var(--page-padding);
  background: var(--color-bg-card);
}

.search-box {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-full);
  gap: var(--spacing-sm);
}

.search-icon {
  font-size: var(--font-size-md);
}

.search-input {
  flex: 1;
  font-size: var(--font-size-md);
}

.search-clear {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  padding: var(--spacing-xs);
}

/* ── Tab 切换 ── */
.tabs {
  display: flex;
  background: var(--color-bg-card);
  border-bottom: 1rpx solid var(--color-border);
}

.tab {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: var(--spacing-md);
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  position: relative;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
}

/* ── 分类筛选 ── */
.category-bar {
  display: flex;
  background: var(--color-bg-card);
  padding: var(--spacing-sm) var(--spacing-md);
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  padding: var(--spacing-xs) var(--spacing-md);
  margin-right: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-full);
}

.category-chip.active {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

/* ── 动作列表 ── */
.exercise-list {
  flex: 1;
  padding: var(--spacing-md) var(--page-padding);
}

/* ── 创建入口 ── */
.create-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  border: 2rpx dashed var(--color-primary);
  background: var(--color-primary-light);
}

.create-icon {
  font-size: var(--font-size-xl);
  color: var(--color-primary);
  font-weight: bold;
}

.create-text {
  font-size: var(--font-size-md);
  color: var(--color-primary);
}

/* ── 空状态 ── */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xxl);
  gap: var(--spacing-md);
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

/* ── 动作卡片 ── */
.exercise-card {
  margin-bottom: var(--spacing-md);
  padding: var(--spacing-md);
}

.exercise-info {
  margin-bottom: var(--spacing-sm);
}

.exercise-name {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.exercise-english {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-left: var(--spacing-sm);
}

.exercise-meta {
  display: flex;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
}

.exercise-category {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  padding: 4rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
}

.exercise-type {
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx var(--spacing-sm);
  border-radius: var(--radius-sm);
}

.exercise-type.cardio {
  color: #E8A0A0;
  background: #FDF0F0;
}

.exercise-defaults {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* ── 动作卡片操作区 ── */
.exercise-main {
  flex: 1;
}

.exercise-actions {
  display: flex;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-sm);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid var(--color-border);
}

.action-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: var(--spacing-xs) var(--spacing-sm);
  background: var(--color-bg);
  border-radius: var(--radius-sm);
}

.action-item.video {
  color: var(--color-primary);
}

.action-icon {
  font-size: var(--font-size-sm);
}

.action-text {
  font-size: var(--font-size-xs);
}

/* ── 弹窗 ── */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: 0;
  overflow: hidden;
}

.modal-header {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg) var(--spacing-lg) var(--spacing-md);
  border-bottom: 1rpx solid var(--color-border);
}

.modal-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.modal-close {
  font-size: var(--font-size-lg);
  color: var(--color-text-tertiary);
  padding: var(--spacing-xs);
}

/* ── 表单 ── */
.form-section {
  flex: 1;
  min-height: 0;
  max-height: 50vh;
  padding: var(--spacing-md) var(--spacing-lg);
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.form-row:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.form-input {
  height: 80rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-md);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.type-selector {
  display: flex;
  gap: var(--spacing-sm);
}

.type-option {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.type-option.active {
  color: var(--color-primary);
  background: var(--color-primary-light);
  font-weight: 600;
}

/* ── 弹窗底部 ── */
.modal-footer {
  flex-shrink: 0;
  padding: var(--spacing-md) var(--spacing-lg);
  border-top: 1rpx solid var(--color-border);
  background: var(--color-bg-card);
}

.create-btn {
  width: 100%;
}

.create-btn.disabled {
  opacity: 0.6;
}
